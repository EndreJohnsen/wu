{
  "name": "@endrejohnsen/wu",
  "version": "1.1.0",
  "description": "Terminal addon manager for WoW Forever: update, search, import, share and install addons from CurseForge. Runs on Bun.",
  "private": true,
  "license": "UNLICENSED",
  "author": "EndreJohnsen",
  "homepage": "https://github.com/EndreJohnsen/wu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndreJohnsen/wu.git"
  },
  "bugs": {
    "url": "https://github.com/EndreJohnsen/wu/issues"
  },
  "type": "module",
  "bin": {
    "wu": "src/wu.ts"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "wu": "bun src/wu.ts"
  },
  "keywords": [
    "wow",
    "world-of-warcraft",
    "addons",
    "curseforge",
    "cli"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
