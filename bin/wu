ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def _cw(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def dwidth(s):
    return sum(_cw(c) for c in s)


def dfit(s, w):
    """Pad or truncate (with …) to exactly `w` terminal columns, counting wide CJK glyphs as 2."""
    if dwidth(s) <= w:
        return s + " " * (w - dwidth(s))
    out, used = [], 0
    for c in s:
        if used + _cw(c) > w - 1:
            break
        out.append(c)
        used += _cw(c)
    return "".join(out) + "…" + " " * (w - used - 1)


def clip(s, width):
    """Truncate to `width` visible columns, keeping ANSI codes intact."""
    out, seen, i = [], 0, 0
    while i < len(s):
        m = ANSI.match(s, i)
        if m:
            out.append(m.group())
            i = m.end()
            continue
        cw = _cw(s[i])
        if seen + cw > width:
            break
        out.append(s[i])
        seen += cw
        i += 1
    return "".join(out)


def hl_cmd(cmd, base=GRAY):
    """Syntax-highlight a command line; `base` is the color to resume afterwards."""
    if not COLOR:
        return cmd
    out = []
    for i, tok in enumerate(re.split(r"(\s+)", cmd)):
        if not tok or tok.isspace():
            out.append(tok)
            continue
        if tok == "wu":
            style = SX_PROG
        elif tok.startswith("-"):
            style = SX_FLAG
        elif tok[0] in "<[" and tok[-1] in ">]":
            style = SX_HOLE
        elif tok.startswith("/") and "/" not in tok[1:]:
            style = SX_GAME
        elif tok.startswith(("~", "/", "http", "C:")):
            style = SX_PATH
        elif tok in SUBCOMMANDS and i <= 2:
            style = SX_SUB
        else:
            style = SX_ARG
        out.append(f"{RESET}{style}{tok}")
    return "".join(out) + RESET + base


def rich(text, base=GRAY):
    """Tiny markup for prose: `code` gets syntax colors, {key} renders as a keycap."""
    if not COLOR:
        return text.replace("`", "").replace("{", "").replace("}", "")
    text = re.sub(r"`([^`]+)`", lambda m: hl_cmd(m.group(1), base), text)
    text = re.sub(r"\{([^}]+)\}", lambda m: f"{RESET}{SX_KEY}{m.group(1)}{RESET}{base}", text)
    return base + text + RESET


def plain(s):
    return ANSI.sub("", s)


def shimmer(text, frame):
    if not COLOR:
        return text
    pos = frame % (len(text) + 12) - 6
    return "".join((SHINE if abs(i - pos) <= 1 else CLAUDE) + ch for i, ch in enumerate(text))


def fmt_dur(secs):
    secs = int(secs)
    return f"{secs}s" if secs < 60 else f"{secs // 60}m {secs % 60}s"


def fmt_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def tilde(p):
    s = str(p)
    home = str(Path.home())
    return "~" + s[len(home):] if s.startswith(home) else s


def short_path(p, width=44):
    s = tilde(p)
    if len(s) <= width:
        return s
    parts = s.split("/")
    return "/".join(parts[:3]) + "/…/" + parts[-1]


class Live:
    """A redrawn region at the bottom of the terminal, with permanent log lines above it."""

    def __init__(self):
        self.lock = threading.RLock()
        self.lines_drawn = 0
        self.render = None
        self.frame = 0
        self.stop_evt = threading.Event()
        self.thread = None

    def start(self, render):
        with self.lock:
            self.render = render
            if TTY:
                sys.stdout.write("\x1b[?25l")
                self._draw()
        if TTY and self.thread is None:
            self.stop_evt.clear()
            self.thread = threading.Thread(target=self._loop, daemon=True)
            self.thread.start()

    def _loop(self):
        while not self.stop_evt.wait(0.08):
            with self.lock:
                self.frame += 1
                self._draw()

    def _clear(self):
        if self.lines_drawn:
            sys.stdout.write(f"\x1b[{self.lines_drawn}F\x1b[J")
            self.lines_drawn = 0

    def _draw(self):
        if not self.render:
            return
        try:
            lines = self.render(self.frame)
        except Exception:
            return
        width = max(20, shutil.get_terminal_size().columns - 1)
        up = f"\x1b[{self.lines_drawn}F" if self.lines_drawn else ""
        sys.stdout.write(up + "".join(clip(line, width) + RESET + "\x1b[K\n" for line in lines) + "\x1b[J")
        sys.stdout.flush()
        self.lines_drawn = len(lines)

    def refresh(self):
        with self.lock:
            if TTY:
                self._draw()

    def log(self, s=""):
        with self.lock:
            if TTY:
                self._clear()
            sys.stdout.write((s if COLOR else plain(s)) + RESET + "\n")
            if TTY and self.render:
                self._draw()
            sys.stdout.flush()

    def stop(self):
        self.stop_evt.set()
        if self.thread:
            self.thread.join()
            self.thread = None
        with self.lock:
            if TTY:
                self._clear()
            self.render = None
            sys.stdout.flush()


live = Live()


def bullet(status, frame=0):
    if status == "ok":
        return f"{GREEN}●{RESET}"
    if status == "err":
        return f"{RED}●{RESET}"
    if status == "warn":
        return f"{YELLOW}●{RESET}"
    return f"{WHITE}●{RESET}" if (frame // 5) % 2 == 0 else " "


def result(text, color=GRAY):
    return f"  {GRAY}⎿{RESET}  {color}{text}{RESET}"


class Spinner:
    """WoW-style cast bar: one random 'spell' after another, each with its own cast time."""

    WIDTH = 12

    def __init__(self):
        self.start = time.time()
        rnd = random.Random()
        self.casts = [(name, SCHOOLS[school], rnd.uniform(2.0, 3.6))
                      for name, school in rnd.sample(CASTS, len(CASTS))]
        self.cycle = sum(c[2] for c in self.casts)

    def _current(self, elapsed):
        t = elapsed % self.cycle
        for name, color, dur in self.casts:
            if t < dur:
                return name, color, dur, t
            t -= dur
        return self.casts[0][0], self.casts[0][1], self.casts[0][2], 0.0

    def line(self, frame, extras=()):
        elapsed = time.time() - self.start
        name, color, dur, t = self._current(elapsed)
        prog = min(1.0, t / dur)
        bright = _mix(color, (255, 255, 255), 0.55)
        if not COLOR:
            filled = round(prog * self.WIDTH)
            bar = "[" + "=" * filled + " " * (self.WIDTH - filled) + "]"
            return f"{SWEEP[round(prog * 4)]} {name}... {bar} ({fmt_dur(elapsed)} · {' · '.join([*extras, 'ctrl+c to cancel'])})"
        icon = f"{rgb(*color)}{SWEEP[round(prog * 4)]}{RESET}"
        # spell name shimmers in its school color
        pos = frame % (len(name) + 14) - 7
        text = "".join((rgb(*bright) if abs(i - pos) <= 1 else rgb(*color)) + ch for i, ch in enumerate(name + "…"))
        # cast bar with smooth eighth-block fill; flashes white right as the cast lands
        cells = prog * self.WIDTH
        full, part = int(cells), int((cells - int(cells)) * 8)
        bar_color = rgb(*bright) if prog > 0.94 else rgb(*color)
        bar = bar_color + "█" * full
        if full < self.WIDTH:
            bar += (" ▏▎▍▌▋▊▉"[part] if part else "") + GRAY + "░" * (self.WIDTH - full - (1 if part else 0))
        left = f"{max(0.0, dur - t):.1f}s"
        bits = [fmt_dur(elapsed), *extras, "ctrl+c to cancel"]
        return (f"{icon} {text}{RESET} {GRAY}▕{RESET}{bar}{RESET}{GRAY}▏{RESET} {GRAY}{left:>4}  "
                f"({' · '.join(bits)}){RESET}")


# ── the engram: a spinning ASCII dodecahedron ───────────────────────────────

PHI = (1 + 5 ** 0.5) / 2
ENGRAM_ROWS = 13
ENGRAM_YAW = 0.3      # resting pose
ENGRAM_PITCH = 0.35   # tilted toward you so the top face shows
ENGRAM_SPIN_SECS = (0.7, 0.9)  # each run picks a random length in this range
ASPECT = 2.05         # terminal cells are about twice as tall as wide
HATCH = " ..::;;"     # lit faces stay open, shadowed sides get filled in
# while it spins the fill pattern and colors are rolled at random, then settle back to HATCH + orange
SPIN_HATCHES = [" ..::;;", " .-=+*#", " .:oO@", " .,~=%", " .*#%@", " -=xX#"]
SPIN_PALETTES = {
    "rainbow": None,
    "engram": [(163, 53, 238), (255, 200, 60), (80, 140, 255), (90, 200, 110), (235, 235, 235)],
    "ember": [(255, 80, 40), (255, 150, 30), (255, 215, 90), (200, 40, 40)],
    "arcane": [(130, 90, 255), (60, 170, 255), (195, 110, 255), (80, 230, 220)],
    "fel": [(90, 220, 70), (170, 255, 90), (40, 170, 70), (210, 255, 150)],
    "frost": [(150, 220, 255), (90, 160, 255), (225, 245, 255), (110, 200, 235)],
}


def _sub(a, b): return (a[0] - b[0], a[1] - b[1], a[2] - b[2])
def _dot(a, b): return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
def _cross(a, b): return (a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0])


def _unit(a):
    m = _dot(a, a) ** 0.5
    return (a[0] / m, a[1] / m, a[2] / m)


def _dodecahedron():
    verts = [(x, y, z) for x in (-1, 1) for y in (-1, 1) for z in (-1, 1)]
    for s1 in (-1, 1):
        for s2 in (-1, 1):
            verts += [(0, s1 / PHI, s2 * PHI), (s1 / PHI, s2 * PHI, 0), (s1 * PHI, 0, s2 / PHI)]
    faces = []
    for s1 in (-1, 1):
        for s2 in (-1, 1):
            for n in ((0, s1 * PHI, s2), (s2, 0, s1 * PHI), (s1 * PHI, s2, 0)):
                d = [_dot(v, n) for v in verts]
                idx = [i for i, x in enumerate(d) if abs(x - max(d)) < 1e-9]
                c = tuple(sum(verts[i][k] for i in idx) / 5 for k in range(3))
                u = _unit(_sub(verts[idx[0]], c))
                w = _cross(_unit(n), u)
                idx.sort(key=lambda i: math.atan2(_dot(_sub(verts[i], c), w), _dot(_sub(verts[i], c), u)))
                faces.append(idx)
    edges = {}
    for fi, f in enumerate(faces):
        for k in range(5):
            edges.setdefault(tuple(sorted((f[k], f[(k + 1) % 5]))), []).append(fi)
    return verts, faces, edges


D_VERTS, D_FACES, D_EDGES = _dodecahedron()
LIGHT = _unit((-0.55, 0.65, 0.75))


def _rotate(p, yaw, pitch, roll=0.0):
    x, y, z = p
    c, s_ = math.cos(yaw), math.sin(yaw)
    x, z = x * c + z * s_, -x * s_ + z * c
    c, s_ = math.cos(pitch), math.sin(pitch)
    y, z = y * c - z * s_, y * s_ + z * c
    if roll:
        c, s_ = math.cos(roll), math.sin(roll)
        x, y = x * c - y * s_, x * s_ + y * c
    return (x, y, z)


def _line(x1, y1, x2, y2):
    """ASCII line in cell space: one glyph per row when steep, one per column
    (stepping between _ - and the row above) when shallow."""
    dx, dy = x2 - x1, y2 - y1
    ang = math.degrees(math.atan2(-dy * ASPECT, dx)) % 180
    out = []
    if 44 <= ang <= 136:
        ch = "|" if 72 <= ang <= 108 else ("/" if ang < 90 else "\\")
        ra, rb = sorted((y1, y2))
        for r in range(math.floor(ra), math.floor(rb) + 1):
            yc = min(max(r + 0.5, ra), rb)
            t = 0.0 if dy == 0 else (yc - y1) / dy
            out.append((int(x1 + dx * t), r, ch))
    else:
        ca, cb = sorted((x1, x2))
        for c in range(math.floor(ca), math.floor(cb) + 1):
            xc = min(max(c + 0.5, ca), cb)
            t = 0.0 if dx == 0 else (xc - x1) / dx
            y = y1 + dy * t
            r = math.floor(y)
            fy = y - r
            if fy < 0.28:
                r, ch = r - 1, "_"
            else:
                ch = "-" if fy < 0.72 else "_"
            out.append((c, r, ch))
    return out


def engram_grid(yaw, pitch, roll=0.0, hatch=HATCH, rows=ENGRAM_ROWS):
    """Rows of (char, kind, shade, face) cells; kind is None, 'fill', 'edge' or 'rim'."""
    sy = (rows - 1.2) / (2 * 3 ** 0.5)
    sx = sy * ASPECT
    cols = int(2 * 3 ** 0.5 * sx + 3)
    cx, cy = cols / 2, rows / 2
    pv = [_rotate(v, yaw, pitch, roll) for v in D_VERTS]
    proj = [(cx + x * sx, cy - y * sy) for x, y, _ in pv]
    grid = [[(" ", None, 0.0, -1)] * cols for _ in range(rows)]

    visible = {}
    for fi, f in enumerate(D_FACES):
        n = _unit(_cross(_sub(pv[f[1]], pv[f[0]]), _sub(pv[f[2]], pv[f[0]])))
        centroid = tuple(sum(pv[i][k] for i in f) / 5 for k in range(3))
        if _dot(n, centroid) < 0:
            n = (-n[0], -n[1], -n[2])
        if n[2] > 0.08:  # skip faces seen almost edge-on
            visible[fi] = n

    for fi, n in visible.items():
        poly = [proj[i] for i in D_FACES[fi]]
        shade = 1.0 - max(0.0, _dot(n, LIGHT))
        level = min(len(hatch) - 1, int(shade * shade * len(hatch) * 1.15))
        xs = [q[0] for q in poly]
        ys = [q[1] for q in poly]
        for r in range(max(0, int(min(ys))), min(rows, int(max(ys)) + 1)):
            for col in range(max(0, int(min(xs))), min(cols, int(max(xs)) + 1)):
                px, py = col + 0.5, r + 0.5
                sign, inside = 0, True
                for k in range(5):
                    (x1, y1), (x2, y2) = poly[k], poly[(k + 1) % 5]
                    cr = (x2 - x1) * (py - y1) - (y2 - y1) * (px - x1)
                    if abs(cr) < 1e-9:
                        continue
                    if sign == 0:
                        sign = 1 if cr > 0 else -1
                    elif (cr > 0) != (sign > 0):
                        inside = False
                        break
                if inside:
                    ch = hatch[level]
                    if ch == ";" and (r + col) % 3 == 0:
                        ch = ":"
                    grid[r][col] = (ch, "fill", shade, fi)

    for (i, j), fs in D_EDGES.items():
        seen = [f for f in fs if f in visible]
        if not seen:
            continue
        kind = "rim" if len(seen) == 1 else "edge"
        for col, r, ch in _line(*proj[i], *proj[j]):
            if 0 <= r < rows and 0 <= col < cols:
                grid[r][col] = (ch, kind, 0.0, -1)
    return grid


def _smooth(e0, e1, x):
    x = min(1.0, max(0.0, (x - e0) / (e1 - e0)))
    return x * x * (3 - 2 * x)


def _mix(c1, c2, w):
    return tuple(int(a + (b - a) * w) for a, b in zip(c1, c2))


GLOW_LIT = (255, 222, 160)     # pale gold on faces turned to the light
GLOW_SHADOW = (238, 150, 62)   # warm amber in shadow: stays bright, never brown


def _orange(shade):
    """Resting fill color for the engram's hatching (gold→amber), plus the shade step."""
    t = round(min(1.0, max(0.0, (shade - 0.2) / 0.8)) * 5) / 5
    return _mix(GLOW_LIT, GLOW_SHADOW, t), t


class SpinPlan:
    """One random spin: direction, turns, tumble, easing, palette, fill pattern."""

    def __init__(self):
        rnd = random.Random()
        self.secs = rnd.uniform(*ENGRAM_SPIN_SECS)
        self.turns = rnd.uniform(0.55, 1.15) * rnd.choice((-1, 1))
        self.pitch0 = ENGRAM_PITCH + rnd.uniform(-0.8, 0.8)
        self.roll0 = rnd.uniform(-1.0, 1.0)
        self.wobble = rnd.uniform(0.0, 0.35)
        self.wobble_freq = rnd.uniform(1.0, 3.0)
        self.ease_kind = rnd.choice(("cubic", "quart", "back"))
        self.palette_name = rnd.choice(list(SPIN_PALETTES))
        self.palette = SPIN_PALETTES[self.palette_name]
        self.hatch = rnd.choice(SPIN_HATCHES)
        self.hue0 = rnd.random()
        self.hue_speed = rnd.uniform(1.5, 4.0) * rnd.choice((-1, 1))
        self.face_step = rnd.uniform(0.05, 0.2)

    def ease(self, t):
        if self.ease_kind == "cubic":
            return 1 - (1 - t) ** 3
        if self.ease_kind == "quart":
            return 1 - (1 - t) ** 4
        c1 = 1.70158  # back: overshoots a little, then settles
        return 1 + (c1 + 1) * (t - 1) ** 3 + c1 * (t - 1) ** 2

    def pose(self, t):
        e = self.ease(t)
        yaw = ENGRAM_YAW - (1 - e) * self.turns * 2 * math.pi
        pitch = ENGRAM_PITCH + (self.pitch0 - ENGRAM_PITCH) * (1 - e) \
            + self.wobble * math.sin(t * math.pi * self.wobble_freq) * (1 - t)
        return yaw, pitch, self.roll0 * (1 - e)

    def color(self, face, t, bright=False):
        if self.palette is None:
            hue = (self.hue0 + face * self.face_step + t * self.hue_speed * 0.35) % 1.0
            h6 = hue * 6
            k = h6 - int(h6)
            v, s_ = 255, 0.45 if bright else 0.7
            p_, q_, r_ = v * (1 - s_), v * (1 - s_ * k), v * (1 - s_ * (1 - k))
            return [(v, r_, p_), (q_, v, p_), (p_, v, r_), (p_, q_, v), (r_, p_, v), (v, p_, q_)][int(h6) % 6]
        idx = int(face + t * self.hue_speed * 3 + self.hue0 * 12) % len(self.palette)
        base = self.palette[idx]
        return _mix(base, (255, 255, 255), 0.35) if bright else base


def engram_lines(yaw, pitch, roll=0.0, glint=None, plan=None, t=1.0):
    """Colored text rows. With a `plan`, colors and fill come from the random spin and
    blend back to orange as t -> 1. `glint` is the position of a diagonal highlight."""
    home = 1.0 if plan is None else _smooth(0.45, 0.9, t)  # 1 = fully back to orange
    hatch = plan.hatch if plan is not None and home < 0.5 else HATCH
    out = []
    for r, row in enumerate(engram_grid(yaw, pitch, roll, hatch)):
        parts, cur = [], None
        for c, (ch, kind, shade, face) in enumerate(row):
            if ch == " " or not COLOR:
                parts.append(ch)
                continue
            if glint is not None and abs((c + r * 2) - glint) <= 1.5:
                color = "\x1b[38;2;255;240;225m"
            elif kind == "rim":
                color = SHINE
            elif kind == "edge":
                if home >= 1:
                    color = CLAUDE
                else:
                    color = rgb(*_mix(plan.color((c + r) % 12, t, bright=True), (215, 119, 87), home))
            else:
                orange, dark = _orange(shade)
                if home >= 1:
                    color = rgb(*orange)
                else:
                    lit = 1 - 0.55 * dark
                    wild = tuple(int(x * lit) for x in plan.color(face, t))
                    color = rgb(*_mix(wild, orange, home))
            if color != cur:
                parts.append(color)
                cur = color
            parts.append(ch)
        out.append("".join(parts) + RESET)
    return out


def banner(n_addons, info=None):
    info = info or [
        f"{BOLD}wu{RESET} {GRAY}v{VERSION}{RESET}",
        f"{GRAY}WoW Forever {GAME_VERSION} · {n_addons} addons tracked{RESET}",
        f"{GRAY}{short_path(WOW_DIR)}{RESET}",
    ]

    def compose(rows, trim=False):
        if trim:
            while rows and not plain(rows[0]).strip():
                rows = rows[1:]
            while rows and not plain(rows[-1]).strip():
                rows = rows[:-1]
        top = (len(rows) - len(info)) // 2
        return [row + "   " + (info[i - top] if 0 <= i - top < len(info) else "") for i, row in enumerate(rows)]

    if not TTY:
        print("\n".join(plain(row).rstrip() for row in compose(engram_lines(ENGRAM_YAW, ENGRAM_PITCH), trim=True)))
        print()
        return

    width = max(20, shutil.get_terminal_size().columns - 1)
    drawn = 0

    def draw(rows):
        nonlocal drawn
        buf = (f"\x1b[{drawn}F" if drawn else "") + "".join(clip(row, width) + RESET + "\x1b[K\n" for row in rows) + "\x1b[J"
        sys.stdout.write(buf)
        sys.stdout.flush()
        drawn = len(rows)

    sys.stdout.write("\x1b[?25l")
    plan = SpinPlan()
    t0 = time.time()
    while True:  # random spin, eased into the resting pose, colors coming home to orange
        t = min(1.0, (time.time() - t0) / plan.secs)
        yaw, pitch, roll = plan.pose(t)
        draw(compose(engram_lines(yaw, pitch, roll, plan=plan, t=t)))
        if t >= 1:
            break
        time.sleep(1 / 50)
    for g in range(-4, 60, 6):  # a quick glint as it settles
        draw(compose(engram_lines(ENGRAM_YAW, ENGRAM_PITCH, glint=g)))
        time.sleep(1 / 120)
    draw(compose(engram_lines(ENGRAM_YAW, ENGRAM_PITCH), trim=True))
    print()


def finale(text, styled=None):
    """Settle the final ✻ line with one sweep of shimmer; `styled` is the colored resting text."""
    if TTY and COLOR:
        for frame in range(0, len(plain(text)) + 12, 3):
            sys.stdout.write("\r\x1b[K" + f"{CLAUDE}✻{RESET} " + shimmer(text, frame) + RESET)
            sys.stdout.flush()
            time.sleep(0.012)
        sys.stdout.write("\r\x1b[K")
    print(f"{CLAUDE}✻{RESET} {styled if styled else CLAUDE + text}{RESET}")


# ── state ────────────────────────────────────────────────────────────────────


def load_state():
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {"addons": {}}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, STATE_FILE)


def acquire_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fh = open(STATE_DIR / "lock", "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"{RED}●{RESET} Another wu is already running.")
        sys.exit(1)
    return fh


# ── CurseForge (via cfwidget) ────────────────────────────────────────────────


def http_get(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    return urllib.request.urlopen(req, timeout=timeout)


def fetch_project(ref):
    """ref: numeric project id or 'wow/addons/<slug>'."""
    url = f"https://api.cfwidget.com/{ref}"
    last = None
    for attempt in range(6):
        try:
            with http_get(url) as r:
                body = r.read()
                data = json.loads(body) if body else {}
            if r.status == 200 and isinstance(data.get("files"), list):
                return data
            last = data.get("error") or f"HTTP {r.status}"
        except urllib.error.HTTPError as e:
            if e.code == 404:
                raise RuntimeError("not found on CurseForge mirror") from None
            last = f"HTTP {e.code}"
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as e:
            last = str(getattr(e, "reason", e))
        time.sleep(2 + attempt * 2)  # cfwidget queues fresh lookups; give it a moment
    raise RuntimeError(f"mirror didn't answer ({last})")


def pick_file(data):
    files = [f for f in data["files"] if GAME_VERSION in (f.get("versions") or [])]
    for channel in ("release", "beta", "alpha"):
        pool = [f for f in files if f.get("type") == channel]
        if pool:
            return max(pool, key=lambda f: f.get("uploaded_at") or "")
    return None


def pretty_version(f):
    s = re.sub(r"\.zip$", "", f.get("display") or f.get("name") or "?")
    m = re.search(r"\d[\w.\-]*", s)
    return m.group() if m else s


def cdn_url(f):
    fid = int(f["id"])
    return f"https://edge.forgecdn.net/files/{fid // 1000}/{fid % 1000}/{urllib.parse.quote(f['name'])}"


# ── install ──────────────────────────────────────────────────────────────────


def download(f, dest, progress):
    with http_get(cdn_url(f), timeout=60) as r, open(dest, "wb") as out:
        progress["total"] = int(r.headers.get("Content-Length") or f.get("filesize") or 0)
        while True:
            chunk = r.read(1 << 16)
            if not chunk:
                break
            out.write(chunk)
            progress["done"] += len(chunk)
    want = f.get("filesize")
    got = dest.stat().st_size
    if want and int(want) != got:
        raise RuntimeError(f"size mismatch: got {got}, expected {want}")


def extract(zpath, dest):
    with zipfile.ZipFile(zpath) as z:
        members, tops = [], set()
        for info in z.infolist():
            p = PurePosixPath(info.filename)
            if p.is_absolute() or ".." in p.parts or "\\" in info.filename:
                raise RuntimeError(f"unsafe path in zip: {info.filename}")
            if len(p.parts) == 1 and not info.is_dir():
                continue  # stray top-level file, not an addon folder
            tops.add(p.parts[0])
            members.append(info)
        if not tops:
            raise RuntimeError("zip has no addon folders")
        z.extractall(dest, members=members)
    return sorted(tops)


def swap_in(staging, folders, old_folders, backup):
    moved_old, moved_new = [], []
    try:
        for name in sorted(set(folders) | set(old_folders)):
            target = ADDONS_DIR / name
            if target.exists() or target.is_symlink():
                os.rename(target, backup / name)
                moved_old.append(name)
        for name in folders:
            os.rename(staging / name, ADDONS_DIR / name)
            moved_new.append(name)
    except BaseException:
        for name in moved_new:
            shutil.rmtree(ADDONS_DIR / name, ignore_errors=True)
        for name in moved_old:
            os.rename(backup / name, ADDONS_DIR / name)
        raise


def install(entry, f, progress, workdir):
    tmp = Path(tempfile.mkdtemp(prefix="job-", dir=workdir))
    try:
        zpath = tmp / "addon.zip"
        download(f, zpath, progress)
        progress["phase"] = "unpacking"
        staging = tmp / "staging"
        staging.mkdir()
        folders = extract(zpath, staging)
        backup = tmp / "backup"
        backup.mkdir()
        progress["phase"] = "installing"
        swap_in(staging, folders, entry.get("folders") or [], backup)
        return folders
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ── commands ─────────────────────────────────────────────────────────────────


def wow_running():
    for p in Path("/proc").iterdir():
        if p.name.isdigit():
            try:
                if b"wow.exe" in (p / "cmdline").read_bytes().lower():
                    return True
            except OSError:
                pass
    return False


def start_checks(addons):
    pool = ThreadPoolExecutor(max_workers=6)
    return pool, {pool.submit(fetch_project, pid): pid for pid in addons}


def check_all(state, pool, futures):
    addons = state["addons"]
    results = {}
    spin = Spinner()
    pending = {pid: a["title"] for pid, a in addons.items()}

    def render(frame):
        waiting = next(iter(pending.values()), "")
        return [
            f"{bullet('run', frame)} {BOLD}Check{RESET}({len(addons)} addons)",
            result(f"{len(results)}/{len(addons)} checked" + (f" · asking about {waiting}" if waiting else "")),
            "",
            spin.line(frame),
        ]

    live.start(render)
    try:
        for fut in as_completed(futures):
            pid = futures[fut]
            try:
                data = fut.result()
                results[pid] = ("ok", data, pick_file(data))
            except Exception as e:
                results[pid] = ("err", str(e), None)
            pending.pop(pid, None)
    finally:
        pool.shutdown(wait=False, cancel_futures=True)
        live.stop()
    return results


def cmd_update(args):
    lock = acquire_lock()  # noqa: F841 (held for the process lifetime)
    check_only = "--check" in args
    force = "--force" in args
    state = load_state()
    addons = state["addons"]
    t0 = time.time()

    found = ADDONS_DIR.parent.exists()
    if not addons:
        banner(0)
        print(f"{bullet('ok')} {BOLD}Welcome{RESET}")
        print(result("wu isn't tracking any addons yet. Start with one of these:"))
        for cmd, desc in (("wu import", "adopt the addons already in your AddOns folder"),
                          ("wu search bags", "find WoW Forever addons and install one"),
                          ("wu setup", "if wu found the wrong WoW folder")):
            print(f"     {hl_cmd(cmd)}{' ' * (16 - len(cmd))}{GRAY}{desc}{RESET}")
        return 0
    pool, futures = start_checks(addons) if found else (None, None)
    banner(len(addons))
    if not found:
        live.log(f"{bullet('err')} Can't find WoW Forever at {tilde(WOW_DIR)}")
        live.log(result(rich("Run `wu setup` and paste where it lives now.", RED), RED))
        return 1
    ADDONS_DIR.mkdir(parents=True, exist_ok=True)
    if wow_running() and not check_only:
        live.log(f"{bullet('warn')} WoW is running")
        live.log(result("Files update on disk now; type /reload in game (or relog) to load them.", YELLOW))
        live.log()

    results = check_all(state, pool, futures)

    todo, errors, fresh = [], [], []
    for pid, a in addons.items():
        status, data, f = results.get(pid, ("err", "no answer", None))
        if status == "err":
            errors.append((a["title"], data))
        elif f is None:
            errors.append((a["title"], f"no WoW Forever ({GAME_VERSION}) build published"))
        else:
            a["title"] = data.get("title") or a["title"]
            folders = a.get("folders") or []
            missing = not folders or not all((ADDONS_DIR / d).exists() for d in folders)
            if force or missing or a.get("file_id") != f["id"]:
                todo.append((pid, a, f))
            else:
                fresh.append(a["title"])

    live.log(f"{bullet('warn' if errors else 'ok')} {BOLD}Check{RESET}({len(addons)} addons)")
    summary = f"{len(todo)} update{'s' if len(todo) != 1 else ''} available · {len(fresh)} up to date"
    live.log(result(summary))
    for title, why in errors:
        live.log(f"     {RED}✗ {title}: {why}{RESET}")
    live.log()

    if check_only:
        for _, a, f in todo:
            live.log(f"  {CLAUDE}↑{RESET} {a['title']}  {GRAY}{a.get('version') or 'new'} → {RESET}{pretty_version(f)}")
        if todo:
            live.log()
            live.log(rich("Run `wu` to install them."))
        save_state(state)
        return 1 if errors else 0

    done, failed = [], []
    if todo:
        width = max(len(a["title"]) for _, a, _ in todo)
        prev = {pid: a.get("version") or "new" for pid, a, _ in todo}  # before install overwrites it
        status = {pid: "todo" for pid, _, _ in todo}
        notes = {}
        progress = {"done": 0, "total": 0, "phase": "downloading"}
        current = {"pid": None}
        spin = Spinner()
        workdir = WOW_DIR / "Interface" / ".wu"
        workdir.mkdir(exist_ok=True)

        def todo_lines(frame, final=False):
            out = [f"{bullet('ok' if final and not failed else ('err' if final else 'run'), frame)} {BOLD}Update Todos{RESET}"]
            for i, (pid, a, f) in enumerate(todo):
                pad = a["title"].ljust(width)
                ver = f"{prev[pid]} → {pretty_version(f)}"
                st = status[pid]
                if st == "done":
                    body = f"{GREEN}☒ {STRIKE}{pad}{RESET}  {GRAY}{ver}{RESET}"
                elif st == "fail":
                    body = f"{RED}✗ {pad}  {notes.get(pid, '')}{RESET}"
                elif st == "run":
                    total = progress["total"] or 1
                    frac = min(1.0, progress["done"] / total)
                    bar = "▰" * round(frac * 10) + "▱" * (10 - round(frac * 10))
                    body = f"{CLAUDE}■ {BOLD}{pad}{RESET}  {GRAY}{ver}{RESET}  {CLAUDE}{bar}{RESET} {GRAY}{progress['phase']}{RESET}"
                else:
                    body = f"{WHITE}☐ {pad}{RESET}  {GRAY}{ver}{RESET}"
                lead = f"  {GRAY}⎿{RESET}  " if i == 0 else "     "
                out.append(lead + body)
            return out

        def render(frame):
            extras = []
            if progress["total"]:
                extras.append(f"↓ {fmt_size(progress['done'])}/{fmt_size(progress['total'])}")
            return todo_lines(frame) + ["", spin.line(frame, extras)]

        live.start(render)
        try:
            for pid, a, f in todo:
                current["pid"] = pid
                status[pid] = "run"
                progress.update(done=0, total=int(f.get("filesize") or 0), phase="downloading")
                try:
                    folders = install(a, f, progress, workdir)
                    a.update(file_id=f["id"], file_name=f["name"], version=pretty_version(f), folders=folders,
                             updated_at=time.strftime("%Y-%m-%d %H:%M"))
                    save_state(state)
                    status[pid] = "done"
                    done.append(a["title"])
                except Exception as e:
                    status[pid] = "fail"
                    notes[pid] = str(e)[:80]
                    failed.append((a["title"], str(e)))
        finally:
            live.stop()
            try:
                workdir.rmdir()
            except OSError:
                pass
        for line in todo_lines(0, final=True):
            live.log(line)
        live.log()

    save_state(state)
    took = fmt_dur(time.time() - t0)
    if failed or errors:
        n = len(failed) + len(errors)
        finale(f"{random.choice(DONE_VERBS)} for {took} · {len(done)} updated · {n} had trouble (see above)")
        return 1
    if done:
        finale(f"{random.choice(DONE_VERBS)} for {took} · DING! {len(done)} addon{'s' if len(done) != 1 else ''} leveled up · {len(fresh)} already fresh")
    else:
        finale(f"{random.choice(IDLE_VERBS)} for {took} · all {len(fresh)} addons are already fresh")
    return 0


# ── keyboard + input widgets ─────────────────────────────────────────────────


class RawKeys:
    """Single keypresses from the terminal (cbreak mode, so ctrl+c still works)."""

    KEYS = {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
            b"OA": "up", b"OB": "down", b"OC": "right", b"OD": "left",
            b"[Z": "shift-tab", b"[H": "home", b"[F": "end", b"[5~": "pgup", b"[6~": "pgdn"}

    def __enter__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        return self

    def __exit__(self, *exc):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def read(self):
        ch = os.read(self.fd, 1)
        if ch == b"\x1b":
            seq = b""
            while select.select([self.fd], [], [], 0.03)[0] and len(seq) < 6:
                seq += os.read(self.fd, 1)
                if seq[-1:].isalpha() or seq[-1:] == b"~":
                    break
            return self.KEYS.get(seq, "esc" if not seq else "")
        if ch in (b"\r", b"\n"):
            return "enter"
        if ch == b"\t":
            return "tab"
        if ch == b"\x7f":
            return "backspace"
        return ch.decode("utf-8", "ignore")


def prompt_box(hint=""):
    """Claude-style rounded input box. Returns what was typed/pasted."""
    if not (TTY and sys.stdin.isatty()):
        return input("> ")
    cols = shutil.get_terminal_size().columns
    width = max(30, min(cols - 1, 100))
    inner = width - 2
    top = f"{GRAY}╭{'─' * inner}╮{RESET}"
    bot = f"{GRAY}╰{'─' * inner}╯{RESET}"

    def mid(text=""):
        return f"{GRAY}│{RESET} {CLAUDE}>{RESET} {text}{' ' * max(0, inner - 3 - len(text))}{GRAY}│{RESET}"

    below = [bot] + ([f"  {GRAY}{hint}{RESET}"] if hint else [])
    sys.stdout.write("\n".join([top, mid()] + below) + "\n")
    sys.stdout.write(f"\x1b[{len(below) + 1}F\x1b[4C\x1b[?25h")
    sys.stdout.flush()
    try:
        value = input()
    except EOFError:
        value = ""
    used = 1 + max(0, 4 + len(value) - 1) // cols  # rows the typed line took, if it wrapped
    shown = value if len(value) <= inner - 4 else "…" + value[-(inner - 5):]
    sys.stdout.write(f"\x1b[{used + 1}F\x1b[J" + "\n".join([top, mid(shown), bot]) + "\n")
    sys.stdout.flush()
    return value


# ── wu search ────────────────────────────────────────────────────────────────

SORTS = [(6, "most downloads"), (3, "most recent")]  # CurseForge sortField ids


def search_cf(query, sort_field, page, size=10):
    params = {"gameId": 1, "gameVersion": GAME_VERSION, "sortField": sort_field,
              "sortOrder": "desc", "pageSize": size, "index": page * size}
    if query:
        params["searchFilter"] = query
    with http_get(f"{CF_SEARCH}?{urllib.parse.urlencode(params)}", timeout=20) as r:
        data = json.load(r)
    return data.get("data") or [], int((data.get("pagination") or {}).get("totalCount") or 0)


def fmt_count(n):
    n = int(n or 0)
    for div, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if n >= div:
            v = n / div
            return f"{v:.1f}{suffix}" if v < 100 else f"{v:.0f}{suffix}"
    return str(n)


def released(m):
    """Latest file upload, which is what CurseForge's 'most recent' sort orders by."""
    return m.get("dateReleased") or m.get("dateModified")


def fmt_ago(stamp):
    try:
        then = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
    except ValueError:
        return "?"
    secs = max(0, (datetime.now(timezone.utc) - then).total_seconds())
    for size, unit in ((31536000, "y"), (2592000, "mo"), (86400, "d"), (3600, "h"), (60, "m")):
        if secs >= size:
            return f"{int(secs // size)}{unit} ago"
    return "just now"


def cmd_search(args):
    query = " ".join(args).strip()
    tracked = set(load_state()["addons"])
    label = f'"{query}"' if query else "top addons"
    ui = {"sort": 0, "page": 0, "items": [], "total": 0, "cursor": 0,
          "loading": True, "error": None, "note": ""}

    def fetch():
        ui["loading"], ui["error"] = True, None
        try:
            items, total = search_cf(query, SORTS[ui["sort"]][0], ui["page"])
        except Exception as e:
            items, total = [], 0
            ui["error"] = f"search failed: {getattr(e, 'reason', e)}"
        ui.update(items=items, total=total, cursor=0, loading=False)

    if not (TTY and sys.stdin.isatty()):
        fetch()
        print(f"● Search({label} · WoW Forever · {SORTS[0][1]})")
        if ui["error"]:
            print(f"  ⎿  {ui['error']}")
            return 1
        for i, m in enumerate(ui["items"], 1):
            print(f"  {i:>2}. {m.get('name')}  ({fmt_count(m.get('downloadCount'))} downloads, "
                  f"updated {fmt_ago(released(m))})  wu add {m.get('id')}")
        return 0

    spin = Spinner()

    def render(frame):
        pages = max(1, math.ceil(ui["total"] / 10))
        head = (f"{bullet('ok')} {BOLD}Search{RESET}({label}) {GRAY}· WoW Forever · {RESET}"
                f"{CLAUDE}{SORTS[ui['sort']][1]}{RESET}")
        if ui["loading"]:
            return [head, result("asking CurseForge…"), "", spin.line(frame)]
        if ui["error"]:
            return [head, result(ui["error"], RED), "", "  " + rich("{tab} retry · {q} quit")]
        if not ui["items"]:
            return [head, result(f"No WoW Forever addons match {label}.", YELLOW), "", "  " + rich("{q} quit")]
        lines = [head, result(f"{ui['total']} results · page {ui['page'] + 1}/{pages}"), ""]
        name_w = min(36, max(dwidth(m.get("name") or "") for m in ui["items"]))
        for i, m in enumerate(ui["items"]):
            name = dfit(m.get("name") or "?", name_w)
            num = f"{i + 1}.".rjust(3)
            stats = f"{fmt_count(m.get('downloadCount')):>6} ↓  {fmt_ago(released(m)):>8}"
            have = f"  {GREEN}✓ installed{RESET}" if str(m.get("id")) in tracked else ""
            if i == ui["cursor"]:
                lines.append(f"  {CLAUDE}❯ {num} {BOLD}{name}{RESET}  {GRAY}{stats}{RESET}{have}")
                summary = (m.get("summary") or "").strip()
                who = ", ".join(a.get("name", "") for a in (m.get("authors") or [])[:2])
                if summary or who:
                    lines.append(f"         {GRAY}{summary}{' · by ' + who if who else ''}{RESET}")
            else:
                lines.append(f"    {GRAY}{num}{RESET} {WHITE}{name}{RESET}  {GRAY}{stats}{RESET}{have}")
        lines.append("")
        other = SORTS[1 - ui["sort"]][1]
        lines.append("  " + rich(f"{{↑↓}} move · {{1-9}},{{0}} install · {{enter}} install · {{tab}} {other} · {{←→}} page · {{q}} quit"))
        if ui["note"]:
            lines.append(f"  {ui['note']}")
        return lines

    live.start(render)
    choice = None
    try:
        fetch()
        live.refresh()
        with RawKeys() as keys:
            while True:
                k = keys.read()
                ui["note"] = ""
                n = len(ui["items"])
                pick = None
                if k in ("q", "Q", "esc"):
                    break
                elif k in ("up", "k") and n:
                    ui["cursor"] = (ui["cursor"] - 1) % n
                elif k in ("down", "j") and n:
                    ui["cursor"] = (ui["cursor"] + 1) % n
                elif k in ("tab", "shift-tab", "s"):
                    ui["sort"], ui["page"] = 1 - ui["sort"], 0
                    live.refresh()
                    fetch()
                elif k in ("right", "pgdn", "n") and (ui["page"] + 1) * 10 < ui["total"]:
                    ui["page"] += 1
                    live.refresh()
                    fetch()
                elif k in ("left", "pgup", "p") and ui["page"] > 0:
                    ui["page"] -= 1
                    live.refresh()
                    fetch()
                elif k == "enter" and n:
                    pick = ui["cursor"]
                elif k.isdigit() and n:
                    idx = 9 if k == "0" else int(k) - 1
                    if idx < n:
                        ui["cursor"] = pick = idx
                if pick is not None:
                    m = ui["items"][pick]
                    if str(m.get("id")) in tracked:
                        ui["note"] = rich(f"{m.get('name')} is already installed. Run `wu` to update it.", YELLOW)
                    else:
                        choice = m
                        break
                live.refresh()
    finally:
        live.stop()

    head = f"{bullet('ok')} {BOLD}Search{RESET}({label}) {GRAY}· WoW Forever · {SORTS[ui['sort']][1]}{RESET}"
    if choice is None:
        print(head)
        print(result("Nothing installed."))
        return 0
    print(head)
    print(result(f"Picked {choice.get('name')} · {fmt_count(choice.get('downloadCount'))} downloads · "
                 f"updated {fmt_ago(released(choice))}"))
    print()
    return install_project(str(choice["id"]), choice.get("name") or str(choice["id"]))


# ── wu setup ─────────────────────────────────────────────────────────────────


def wine_prefixes():
    home = Path.home()
    pats = ["Games/*", ".wine", ".wine*", ".local/share/wineprefixes/*",
            ".local/share/Steam/steamapps/compatdata/*/pfx", ".steam/steam/steamapps/compatdata/*/pfx",
            ".local/share/bottles/bottles/*", ".var/app/com.usebottles.bottles/data/bottles/bottles/*",
            ".local/share/lutris/prefixes/*", "Games/*/prefix"]
    seen, out = set(), []
    for pat in pats:
        for pfx in sorted(home.glob(pat)):
            if (pfx / "drive_c").is_dir() and pfx.resolve() not in seen:
                seen.add(pfx.resolve())
                out.append(pfx)
    for parent in WOW_DIR.parents:  # whatever prefix the current setting lives in
        if parent.name == "drive_c" and parent.parent.resolve() not in seen:
            out.insert(0, parent.parent)
            break
    return out


def detect_forever():
    found = []
    for pfx in wine_prefixes():
        for pf in ("Program Files (x86)", "Program Files"):
            cand = pfx / "drive_c" / pf / "World of Warcraft" / "_forever_"
            if cand.is_dir() and cand not in found:
                found.append(cand)
    return found


def to_forever_dir(p):
    """Accepts the _forever_ folder, anything inside it, Wow.exe, or the World of Warcraft folder."""
    if p.is_file():
        p = p.parent
    if not p.is_dir():
        return None, f"{tilde(p)} doesn't exist."
    for i, part in enumerate(p.parts):
        if part.lower() == "_forever_":
            return Path(*p.parts[:i + 1]), None
    for cand in (p / "_forever_", p / "World of Warcraft" / "_forever_"):
        if cand.is_dir():
            return cand, None
    if (p / "Wow.exe").exists():
        return p, None
    flavors = sorted(d.name for d in p.glob("_*_") if d.is_dir())
    if flavors:
        return None, f"No _forever_ folder there (found {', '.join(flavors)}). Is WoW Forever installed?"
    return None, f"{tilde(p)} doesn't look like a World of Warcraft folder."


def resolve_wow_input(raw):
    s = raw.strip().strip("'\"").strip()
    if s.startswith("file://"):
        s = urllib.parse.unquote(s[len("file://"):])
    s = s.replace("\\ ", " ").replace("\\(", "(").replace("\\)", ")")
    m = re.match(r"^([A-Za-z]):[\\/]*(.*)$", s)
    if m:  # a Windows path from inside Wine: try it in every prefix we know
        rest = m.group(2).replace("\\", "/")
        letter = m.group(1).lower()
        why = f"Couldn't find {s} in any Wine prefix. Paste the Linux path instead."
        for pfx in wine_prefixes():
            drive = pfx / "drive_c" if letter == "c" else pfx / "dosdevices" / f"{letter}:"
            path, err = to_forever_dir(drive / rest)
            if path:
                return path, None
            if err and "_forever_" in err:
                why = err
        return None, why
    return to_forever_dir(Path(os.path.expanduser(s)))


def cmd_setup(args):
    global WOW_DIR, ADDONS_DIR
    try:
        n = len(load_state()["addons"])
    except Exception:
        n = 0
    now = short_path(WOW_DIR) if WOW_DIR.exists() else "not set"
    banner(n, [
        f"{BOLD}wu setup{RESET}",
        f"{GRAY}Point wu at your WoW Forever folder{RESET}",
        f"{GRAY}current: {now}{RESET}",
    ])
    found = detect_forever()
    path = None
    if args:
        path, why = resolve_wow_input(" ".join(args))
        if not path:
            print(f"{bullet('err')} {BOLD}Setup{RESET}\n{result(why, RED)}")
            return 1
    else:
        print(f"{bullet('ok')} {BOLD}Setup{RESET}")
        print(result("Paste the path to WoW Forever (the _forever_ folder, World of Warcraft, or Wow.exe)."))
        if found:
            print(f"     {GRAY}Found:{RESET} {tilde(found[0])}")
            print(f"     {GRAY}press enter to use it{RESET}")
            for extra in found[1:3]:
                print(f"     {GRAY}also:{RESET}  {tilde(extra)}")
        print()
        for _ in range(3):
            raw = prompt_box(r"Linux or Windows paths both work, e.g. C:\Program Files (x86)\World of Warcraft")
            if not raw.strip():
                if found:
                    path = found[0]
                    break
                print(result("Nothing pasted. Try again (ctrl+c to quit).", YELLOW))
                print()
                continue
            path, why = resolve_wow_input(raw)
            if path:
                break
            print(result(why, RED))
            print()
        if not path:
            return 1

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"wow_dir": str(path)}, indent=2) + "\n")
    os.replace(tmp, CONFIG_FILE)
    WOW_DIR, ADDONS_DIR = path, path / "Interface" / "AddOns"
    have = sum(1 for d in ADDONS_DIR.glob("*") if d.is_dir() and any(d.glob("*.toc"))) if ADDONS_DIR.is_dir() else 0
    print()
    print(f"{bullet('ok')} {BOLD}Saved{RESET}({tilde(CONFIG_FILE)})")
    print(result(f"WoW Forever: {tilde(path)}"))
    print(f"     {GRAY}{have} addon folder{'s' if have != 1 else ''} in Interface/AddOns{RESET}")
    if os.environ.get("WU_DIR") or os.environ.get("WOW_U_DIR"):
        print(f"     {YELLOW}Note: WU_DIR is set in your environment and overrides this.{RESET}")
    print()
    finale("All set · run wu to install or update your addons there",
           rich("All set · run `wu` to install or update your addons there", CLAUDE))
    return 0


# ── wu import ────────────────────────────────────────────────────────────────

WOW_CODES = re.compile(r"\|c[0-9a-fA-F]{8}|\|r|\|T[^|]*\|t|\|A[^|]*\|a|\|n")


def norm_name(s):
    return re.sub(r"[^a-z0-9]", "", WOW_CODES.sub("", s or "").lower())


def read_toc(folder):
    tocs = sorted(folder.glob("*.toc"), key=lambda t: (
        not t.stem.lower().endswith("_camelot"), t.stem.lower() != folder.name.lower(), t.name))
    fields = {}
    for toc in tocs:
        try:
            lines = toc.read_text(encoding="utf-8", errors="replace").splitlines()[:120]
        except OSError:
            continue
        for line in lines:
            m = re.match(r"^\s*##\s*([^:]+?)\s*:\s*(.*?)\s*$", line)
            if m:
                fields.setdefault(m.group(1).lower(), m.group(2))
    deps = []
    for key in ("dependencies", "requireddeps", "dep", "dependancies"):
        deps += [d.strip() for d in fields.get(key, "").split(",") if d.strip()]
    title = re.sub(r"\s+", " ", WOW_CODES.sub("", fields.get("title") or folder.name)).strip() or folder.name
    cf_id = re.sub(r"\D", "", fields.get("x-curse-project-id", ""))
    return {"title": title, "version": fields.get("version", "").strip(), "cf_id": cf_id or None, "deps": deps}


def cf_get(path):
    with http_get(f"{CF_API}{path}", timeout=20) as r:
        return json.load(r)


def forever_file(mod):
    """(file id, display, file name, module folder names) of the newest WoW Forever build."""
    idx = [i for i in mod.get("latestFilesIndexes") or [] if i.get("gameVersion") == GAME_VERSION]
    if not idx:
        return None
    best = sorted(idx, key=lambda i: (i.get("releaseType", 9), -int(i.get("fileId", 0))))[0]
    files = {f.get("id"): f for f in mod.get("latestFiles") or []}
    f = files.get(best["fileId"], {})
    modules = [m.get("name") for m in f.get("modules") or [] if m.get("name")]
    if not modules:  # file not in latestFiles: folder names rarely change between files
        modules = sorted({m.get("name") for lf in files.values() for m in lf.get("modules") or [] if m.get("name")})
    return {"id": best["fileId"], "name": best.get("filename") or f.get("fileName") or "",
            "display": f.get("displayName") or best.get("filename") or "", "modules": modules}


def version_tokens(s):
    return set(re.findall(r"\d+(?:\.\d+)+", s or ""))


def same_version(installed, ff):
    if not installed or not ff:
        return False
    if pretty_version({"display": installed}) == pretty_version({"display": ff["display"]}):
        return True
    mine = version_tokens(installed)
    return bool(mine) and max(mine, key=len) in (version_tokens(ff["display"]) | version_tokens(ff["name"]))


def make_candidate(mod, folder, title, installed_version, via_toc=False):
    ff = forever_file(mod)
    mods_lower = {m.lower() for m in (ff or {}).get("modules", [])}
    for lf in mod.get("latestFiles") or []:
        mods_lower |= {(m.get("name") or "").lower() for m in lf.get("modules") or []}
    names = {norm_name(mod.get("name")), norm_name(mod.get("slug"))}
    mine = {norm_name(title), norm_name(folder)}
    if via_toc:
        score, why = 1000, "TOC project id"
    elif folder.lower() in mods_lower:
        score, why = 100, "ships this folder"
    else:
        score, why = 0, ""
    if names & mine:
        score += 60
        why = why or "same name"
    else:
        ratio = max(SequenceMatcher(None, a, b).ratio() for a in names for b in mine if a and b)
        score += int(ratio * 50)
        why = why or f"similar name ({int(ratio * 100)}%)"
    score += min(9, int(math.log10((mod.get("downloadCount") or 0) + 1)))
    return {"pid": str(mod.get("id")), "name": mod.get("name") or "?", "downloads": mod.get("downloadCount") or 0,
            "authors": [a.get("name", "") for a in (mod.get("authors") or [])][:2], "score": score, "why": why,
            "file": ff, "modules": (ff or {}).get("modules", []), "forever": ff is not None,
            "current": same_version(installed_version, ff)}


def match_folder(folder, meta):
    """CurseForge candidates for one installed addon folder, best first."""
    cands = {}

    def add(mod, via_toc=False):
        c = make_candidate(mod, folder, meta["title"], meta["version"], via_toc)
        if c["pid"] not in cands or c["score"] > cands[c["pid"]]["score"]:
            cands[c["pid"]] = c

    if meta["cf_id"]:
        try:
            add(cf_get(f"/mods/{meta['cf_id']}")["data"], via_toc=True)
        except Exception:
            pass
    queries = []
    for q in (meta["title"], re.sub(r"(?<=[a-z])(?=[A-Z])|_", " ", folder)):
        q = re.sub(r"\s+", " ", re.sub(r"[^\w\s'-]", " ", q)).strip()[:60]
        if q and q.lower() not in [x.lower() for x in queries]:
            queries.append(q)
    for q in queries:
        if cands and max(c["score"] for c in cands.values()) >= 160:
            break
        for forever_only in (True, False):
            params = {"gameId": 1, "searchFilter": q, "sortField": 2, "sortOrder": "desc", "pageSize": 12}
            if forever_only:
                params["gameVersion"] = GAME_VERSION
            try:
                with http_get(f"{CF_SEARCH}?{urllib.parse.urlencode(params)}", timeout=20) as r:
                    for mod in json.load(r).get("data") or []:
                        add(mod)
            except Exception:
                pass
            if any(c["forever"] and c["score"] >= 60 for c in cands.values()):
                break
    good = [c for c in cands.values() if c["score"] >= (25 if c["forever"] else 60)]
    return sorted(good, key=lambda c: (not c["forever"], -c["score"]))[:6]


def cmd_import(args):
    auto = any(a in ("--yes", "-y") for a in args)
    state = load_state()
    if not ADDONS_DIR.is_dir():
        print(f"{bullet('err')} Can't find {tilde(ADDONS_DIR)}")
        print(result(rich("Run `wu setup` first.", RED), RED))
        return 1
    owned = {f for a in state["addons"].values() for f in a.get("folders") or []}
    found = {}
    for d in sorted(ADDONS_DIR.iterdir(), key=lambda d: d.name.lower()):
        if d.is_dir() and not d.name.startswith((".", "Blizzard_")) and d.name not in owned and any(d.glob("*.toc")):
            found[d.name] = read_toc(d)
    head = f"{bullet('ok')} {BOLD}Import{RESET}({len(found)} untracked folder{'s' if len(found) != 1 else ''})"
    if not found:
        print(head)
        print(result("Everything in AddOns is already tracked by wu."))
        return 0

    names = list(found)
    lower = {n.lower(): n for n in names}

    def parent_of(n):
        for dep in found[n]["deps"]:
            if dep.lower() in lower and lower[dep.lower()] != n:
                return lower[dep.lower()]
        prefixes = [o for o in names if o != n and len(o) >= 3 and n.lower().startswith(o.lower())]
        return max(prefixes, key=len) if prefixes else None

    roots = [n for n in names if parent_of(n) is None]
    matches, progress = {}, {"done": 0, "total": len(roots), "now": ""}
    spin = Spinner()
    live.start(lambda fr: [f"{bullet('run', fr)} {BOLD}Import{RESET}({len(found)} untracked folders)",
                           result(f"matching {progress['done']}/{progress['total']} on CurseForge"
                                  + (f" · {progress['now']}" if progress["now"] else "")), "", spin.line(fr)])

    def run(batch):
        progress["total"] = progress["done"] + len(batch)
        with ThreadPoolExecutor(max_workers=4) as pool:
            futs = {pool.submit(match_folder, n, found[n]): n for n in batch}
            for fut in as_completed(futs):
                n = futs[fut]
                progress["now"] = found[n]["title"]
                try:
                    matches[n] = fut.result()
                except Exception:
                    matches[n] = []
                progress["done"] += 1

    try:
        run(roots)
        rows, claimed = [], set()

        def claim(n):
            cands = matches.get(n) or []
            best = cands[0] if cands else None
            group = {n}
            if best:
                group |= {f for f in names if f.lower() in {m.lower() for m in best["modules"]}}
            group = {g for g in group if g not in claimed}
            claimed.update(group)
            ok = bool(best and best["forever"])
            rows.append({"main": n, "meta": found[n], "folders": sorted(group, key=str.lower),
                         "cands": cands, "ci": 0, "accept": ok and best["score"] >= 60 if ok else None})

        for n in sorted(roots, key=lambda n: -(matches[n][0]["score"] if matches.get(n) else 0)):
            if n not in claimed:
                claim(n)
        leftovers = [n for n in names if n not in claimed]
        if leftovers:  # sub-folders whose parent didn't claim them: try them on their own
            run([n for n in leftovers if n not in matches])
            for n in leftovers:
                if n not in claimed:
                    claim(n)
    finally:
        live.stop()
    rows.sort(key=lambda r: (r["accept"] is None, r["meta"]["title"].lower()))

    def cand(row):
        return row["cands"][row["ci"]] if row["cands"] else None

    def chip(row):
        if row["accept"] is None:
            return f"{GRAY}– skip  {RESET}"
        return f"{GREEN}✓ accept{RESET}" if row["accept"] else f"{RED}✗ deny  {RESET}"

    def row_line(row, selected):
        c = cand(row)
        title = row["meta"]["title"]
        extra = f" +{len(row['folders']) - 1}" if len(row["folders"]) > 1 else ""
        left = dfit(title + extra, 28)
        if c is None:
            right = f"{GRAY}no match on CurseForge{RESET}"
        elif not c["forever"]:
            right = f"{GRAY}{c['name']} is on CurseForge, but has no WoW Forever build{RESET}"
        else:
            right = f"{WHITE}{c['name']}{RESET} {GRAY}#{c['pid']} · {c['why']}{RESET}"
        ptr = f"{CLAUDE}❯{RESET}" if selected else " "
        name = f"{BOLD}{left}{RESET}" if selected else left
        return f"  {ptr} {chip(row)}  {name} {GRAY}→{RESET} {right}"

    if auto or not (TTY and sys.stdin.isatty()):
        print(head)
        for row in rows:
            print("  " + plain(row_line(row, False)) if not COLOR else row_line(row, False))
        if not auto:
            print()
            print(rich("Nothing changed. Run `wu import` in a terminal to review, or `wu import --yes` to take the ✓ ones."))
            return 0
        return finish_import(rows, cand)

    ui = {"cursor": 0, "top": 0}

    def render(frame):
        height = max(6, shutil.get_terminal_size().lines - 14)
        cur = ui["cursor"]
        if cur < ui["top"]:
            ui["top"] = cur
        elif cur >= ui["top"] + height:
            ui["top"] = cur - height + 1
        n_acc = sum(1 for r in rows if r["accept"])
        out = [f"{head} {GRAY}· {len(rows)} addon{'s' if len(rows) != 1 else ''} · {n_acc} to import{RESET}"]
        if ui["top"]:
            out.append(f"     {GRAY}↑ {ui['top']} more{RESET}")
        for i in range(ui["top"], min(len(rows), ui["top"] + height)):
            out.append(row_line(rows[i], i == cur))
        rest = len(rows) - (ui["top"] + height)
        if rest > 0:
            out.append(f"     {GRAY}↓ {rest} more{RESET}")
        row, c = rows[cur], cand(rows[cur])
        out.append("")
        meta = row["meta"]
        folders = ", ".join(row["folders"][:6]) + (f" +{len(row['folders']) - 6}" if len(row["folders"]) > 6 else "")
        out.append(f"     {GRAY}installed{RESET}  {meta['title']} {GRAY}{meta['version'] or ''} · {folders}{RESET}")
        if c:
            state_txt = ("up to date" if c["current"] else f"update available → {pretty_version(c['file'])}") \
                if c["forever"] else "no WoW Forever build"
            who = f" · by {', '.join(c['authors'])}" if c["authors"] else ""
            out.append(f"     {GRAY}curse{RESET}      {c['name']} {GRAY}· {fmt_count(c['downloads'])} downloads{who} · "
                       f"{RESET}{GREEN if c['current'] else CLAUDE}{state_txt}{RESET}")
            if len(row["cands"]) > 1:
                out.append(f"     {GRAY}match {row['ci'] + 1}/{len(row['cands'])} ·{RESET} " + rich("{←→} to see the others"))
        out.append("")
        out.append("  " + rich("{↑↓} move · {y} accept · {n} deny · {space} toggle · {←→} other match · "
                               "{a} accept all · {enter} import · {q} quit"))
        return out

    live.start(render)
    go = False
    try:
        with RawKeys() as keys:
            while True:
                k = keys.read()
                row = rows[ui["cursor"]]
                c = cand(row)
                if k in ("q", "Q", "esc"):
                    break
                if k == "enter":
                    go = True
                    break
                if k in ("up", "k"):
                    ui["cursor"] = (ui["cursor"] - 1) % len(rows)
                elif k in ("down", "j"):
                    ui["cursor"] = (ui["cursor"] + 1) % len(rows)
                elif k in ("y", "Y") and c and c["forever"]:
                    row["accept"] = True
                    ui["cursor"] = min(len(rows) - 1, ui["cursor"] + 1)
                elif k in ("n", "N", "d") and row["accept"] is not None:
                    row["accept"] = False
                    ui["cursor"] = min(len(rows) - 1, ui["cursor"] + 1)
                elif k == " " and row["accept"] is not None:
                    row["accept"] = not row["accept"]
                elif k in ("right", "left", "tab") and len(row["cands"]) > 1:
                    row["ci"] = (row["ci"] + (-1 if k == "left" else 1)) % len(row["cands"])
                    c = cand(row)
                    row["accept"] = (row["accept"] if row["accept"] is not None else False) if c["forever"] else None
                elif k == "a":
                    for r in rows:
                        if r["accept"] is not None:
                            r["accept"] = True
                live.refresh()
    finally:
        live.stop()
    if not go:
        print(head)
        print(result("Nothing imported."))
        return 0
    return finish_import(rows, cand)


def finish_import(rows, cand):
    lock = acquire_lock()  # noqa: F841
    state = load_state()
    taken, skipped, stale = [], 0, 0
    for row in rows:
        c = cand(row)
        if not row["accept"] or not c or not c["forever"]:
            skipped += 1
            continue
        entry = state["addons"].get(c["pid"]) or {"title": c["name"], "file_id": None, "version": None, "folders": []}
        entry["title"] = c["name"]
        entry["folders"] = sorted(set(entry.get("folders") or []) | set(row["folders"]), key=str.lower)
        if c["current"]:
            entry.update(file_id=c["file"]["id"], file_name=c["file"]["name"], version=pretty_version(c["file"]))
        elif not entry.get("file_id"):
            entry["version"] = pretty_version({"display": row["meta"]["version"]}) if row["meta"]["version"] else None
            stale += 1
        entry["updated_at"] = time.strftime("%Y-%m-%d %H:%M")
        state["addons"][c["pid"]] = entry
        taken.append((c, row))
    save_state(state)
    print(f"{bullet('ok')} {BOLD}Import{RESET}({len(taken)} accepted · {skipped} skipped)")
    for i, (c, row) in enumerate(taken):
        lead = f"  {GRAY}⎿{RESET}  " if i == 0 else "     "
        status = f"{GREEN}up to date{RESET}" if c["current"] else f"{CLAUDE}update waiting{RESET}"
        n = len(row["folders"])
        print(f"{lead}{GREEN}✓{RESET} {c['name']} {GRAY}· {n} folder{'s' if n != 1 else ''} ·{RESET} {status}")
    print()
    if not taken:
        finale("Nothing imported this time")
    elif stale:
        finale(f"DING! {len(taken)} imported · run wu to update {stale} of them",
               rich(f"DING! {len(taken)} imported · run `wu` to update {stale} of them", CLAUDE))
    else:
        finale(f"DING! {len(taken)} addon{'s' if len(taken) != 1 else ''} imported · all up to date")
    return 0


HELP_COMMANDS = [
    ("wu", "update every tracked addon"),
    ("wu --check", "look for updates, change nothing"),
    ("wu --force", "reinstall everything, even if up to date"),
    ("wu list", "show tracked addons and their versions"),
    ("wu search [words]", "find WoW Forever addons, pick 1-10 to install"),
    ("wu add <addon>", "install and track a new addon"),
    ("", "(a CurseForge link, slug, or project id)"),
    ("wu setup", "paste where WoW Forever is installed"),
    ("wu import", "match addons already in AddOns to CurseForge"),
    ("wu --version", "print the installed version"),
    ("wu help", "this screen"),
]

HELP_TIPS = [
    "If WoW is open while you update, type `/reload` in game afterwards",
    "In `wu search`: {↑↓} move · {1-9}/{0} install · {tab} most downloads ⇄ most recent · {←→} page",
    "In `wu import`: {y} accept · {n} deny · {←→} other matches · {enter} import",
    f"Only WoW Forever builds ({GAME_VERSION}) are installed, newest stable first",
    "A failed install puts the old version back, so it's always safe to run",
    f"Settings: `{tilde(CONFIG_FILE)}` · state: `{tilde(STATE_FILE)}`",
]


def cmd_help(_args):
    try:
        n = len(load_state()["addons"])
    except Exception:
        n = 0
    banner(n, [
        f"{BOLD}wu{RESET} {GRAY}v{VERSION}{RESET}",
        f"{GRAY}Keeps your WoW Forever addons fresh{RESET}",
        f"{GRAY}{n} addons tracked · {short_path(WOW_DIR)}{RESET}",
    ])
    width = max(len(c) for c, _ in HELP_COMMANDS) + 3
    print(f"{bullet('ok')} {BOLD}Commands{RESET}")
    for i, (cmd, desc) in enumerate(HELP_COMMANDS):
        lead = f"  {GRAY}⎿{RESET}  " if i == 0 else "     "
        print(f"{lead}{hl_cmd(cmd)}{' ' * (width - len(cmd))}{GRAY}{desc}{RESET}")
    print()
    print(f"{bullet('ok')} {BOLD}Tips{RESET}")
    for i, tip in enumerate(HELP_TIPS):
        lead = f"  {GRAY}⎿{RESET}  " if i == 0 else "     "
        print(f"{lead}{rich(tip)}")
    print()
    finale("Try: wu search bags", f"{CLAUDE}Try:{RESET} {hl_cmd('wu search bags', RESET)}")
    return 0


def cmd_list(_args):
    state = load_state()
    addons = sorted(state["addons"].items(), key=lambda kv: kv[1]["title"].lower())
    width = max((len(a["title"]) for _, a in addons), default=0)
    vwidth = max((len(a.get("version") or "not installed") for _, a in addons), default=0)
    print(f"{bullet('ok')} {BOLD}Tracked addons{RESET}({len(addons)})")
    for i, (pid, a) in enumerate(addons):
        lead = f"  {GRAY}⎿{RESET}  " if i == 0 else "     "
        ver = (a.get("version") or "not installed").ljust(vwidth)
        when = f"  {GRAY}{a['updated_at']}{RESET}" if a.get("updated_at") else ""
        print(f"{lead}{a['title'].ljust(width)}  {CLAUDE}{ver}{RESET}{when}  {GRAY}#{pid}{RESET}")
    return 0


def cmd_add(args):
    if not args:
        print(f"{RED}●{RESET} usage: {hl_cmd('wu add <slug|curseforge-url|project-id>', RESET)}")
        return 2
    raw = args[0].strip()
    m = re.search(r"curseforge\.com/wow/addons/([\w-]+)", raw)
    ref = f"wow/addons/{m.group(1)}" if m else (raw if raw.isdigit() else f"wow/addons/{raw}")
    return install_project(ref, raw)


def install_project(ref, raw):
    lock = acquire_lock()  # noqa: F841
    state = load_state()
    if not ADDONS_DIR.parent.exists():
        print(f"{bullet('err')} Can't find WoW Forever at {tilde(WOW_DIR)}")
        print(result(rich("Run `wu setup` first.", RED), RED))
        return 1

    spin = Spinner()
    live.start(lambda fr: [f"{bullet('run', fr)} {BOLD}Lookup{RESET}({raw})", "", spin.line(fr)])
    try:
        data = fetch_project(ref)
    except Exception as e:
        live.stop()
        print(f"{bullet('err')} {BOLD}Lookup{RESET}({raw})\n{result(str(e), RED)}")
        return 1
    live.stop()
    pid = str(data["id"])
    title = data.get("title") or raw
    f = pick_file(data)
    print(f"{bullet('ok')} {BOLD}Lookup{RESET}({raw})")
    if pid in state["addons"]:
        print(result(rich(f"{title} is already tracked. Run `wu` to update it.")))
        return 0
    if f is None:
        print(result(f"{title} has no WoW Forever ({GAME_VERSION}) build yet.", RED))
        return 1
    print(result(f"{title} {pretty_version(f)} · {fmt_size(int(f.get('filesize') or 0))}"))
    print()

    entry = {"title": title, "file_id": None, "version": None, "folders": []}
    progress = {"done": 0, "total": int(f.get("filesize") or 0), "phase": "downloading"}
    workdir = WOW_DIR / "Interface" / ".wu"
    ADDONS_DIR.mkdir(parents=True, exist_ok=True)
    workdir.mkdir(exist_ok=True)
    spin = Spinner()
    live.start(lambda fr: [f"{bullet('run', fr)} {BOLD}Install{RESET}({title})",
                           result(progress["phase"]), "",
                           spin.line(fr, [f"↓ {fmt_size(progress['done'])}/{fmt_size(progress['total'] or 1)}"])])
    try:
        folders = install(entry, f, progress, workdir)
    except Exception as e:
        live.stop()
        print(f"{bullet('err')} {BOLD}Install{RESET}({title})\n{result(str(e), RED)}")
        return 1
    finally:
        live.stop()
        try:
            workdir.rmdir()
        except OSError:
            pass
    entry.update(file_id=f["id"], file_name=f["name"], version=pretty_version(f), folders=folders,
                 updated_at=time.strftime("%Y-%m-%d %H:%M"))
    state["addons"][pid] = entry
    save_state(state)
    print(f"{bullet('ok')} {BOLD}Install{RESET}({title})")
    print(result(f"{len(folders)} folder{'s' if len(folders) != 1 else ''}: {', '.join(folders)}"))
    print()
    finale(f"DING! {title} joined the party · wu now tracks {len(state['addons'])} addons")
    return 0


def autodetect_wow_dir():
    """No WU_DIR, no config, default path missing: use the first WoW Forever we can find."""
    global WOW_DIR, ADDONS_DIR
    if os.environ.get("WU_DIR") or os.environ.get("WOW_U_DIR") or CONFIG_FILE.exists() or WOW_DIR.exists():
        return
    found = detect_forever()
    if found:
        WOW_DIR, ADDONS_DIR = found[0], found[0] / "Interface" / "AddOns"
        print(rich(f"Using WoW Forever found at `{tilde(found[0])}` (run `wu setup` to choose another)"))
        print()


def main(argv):
    if not argv or argv[0] not in ("-h", "--help", "help", "-help", "?", "--version", "-V", "version", "setup"):
        autodetect_wow_dir()
    if argv and argv[0] in ("-h", "--help", "help", "-help", "?"):
        return cmd_help(argv)
    if argv and argv[0] in ("--version", "-V", "version"):
        print(f"wu {VERSION}")
        return 0
    if argv and argv[0] == "list":
        return cmd_list(argv[1:])
    if argv and argv[0] == "add":
        return cmd_add(argv[1:])
    if argv and argv[0] in ("search", "find", "s"):
        return cmd_search(argv[1:])
    if argv and argv[0] == "setup":
        return cmd_setup(argv[1:])
    if argv and argv[0] == "import":
        return cmd_import(argv[1:])
    unknown = [a for a in argv if a not in ("--check", "--force")]
    if unknown:
        print(f"{RED}●{RESET} unknown argument: {unknown[0]}  " + rich("(try `wu help`)"))
        return 2
    return cmd_update(argv)


if __name__ == "__main__":
    code = 1
    try:
        code = main(sys.argv[1:])
    except KeyboardInterrupt:
        live.stop()
        print(f"  {GRAY}⎿{RESET}  {RED}Interrupted by user{RESET}")
        if TTY:
            sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()
        os._exit(130)  # don't wait on in-flight network threads
    finally:
        if TTY:
            sys.stdout.write("\x1b[?25h")
            sys.stdout.flush()
    sys.exit(code)
