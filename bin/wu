TTY = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
COLOR = TTY and not os.environ.get("NO_COLOR")


def rgb(r, g, b):
    return f"\x1b[38;2;{r};{g};{b}m" if COLOR else ""


CLAUDE = rgb(215, 119, 87)
SHINE = rgb(255, 196, 168)
GREEN = rgb(78, 186, 101)
RED = rgb(255, 107, 128)
YELLOW = rgb(255, 193, 7)
GRAY = rgb(140, 140, 140)
WHITE = rgb(235, 235, 235)
BOLD = "\x1b[1m" if COLOR else ""
STRIKE = "\x1b[9m" if COLOR else ""
ITALIC = "\x1b[3m" if COLOR else ""

# shell-style syntax colors for commands shown on screen
SX_PROG = CLAUDE + BOLD                 # wu
SX_SUB = rgb(240, 240, 240) + BOLD      # search, add, setup ...
SX_FLAG = rgb(122, 180, 255)            # --check
SX_HOLE = rgb(180, 160, 225) + ITALIC   # <addon>, [words]
SX_PATH = rgb(152, 200, 121)            # ~/.local/state/...
SX_GAME = rgb(232, 196, 104)            # /reload (in-game slash commands)
SX_ARG = rgb(235, 235, 235)             # plain arguments
SX_KEY = rgb(245, 245, 245) + BOLD      # tab, enter, ↑↓
SUBCOMMANDS = {"list", "search", "find", "add", "setup", "help"}
RESET = "\x1b[0m" if COLOR else ""

# The loading line is a WoW cast bar: every message is a "spell" in its school's color,
# with a cooldown-sweep icon and a cast bar that fill up before the next cast starts.
