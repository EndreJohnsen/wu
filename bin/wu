def _package_version():
    """The version lives in package.json next to bin/ (where bun installs it)."""
    try:
        pkg = Path(os.path.realpath(__file__)).parent.parent / "package.json"
        return json.loads(pkg.read_text())["version"]
    except (OSError, ValueError, KeyError):
        return "dev"


VERSION = _package_version()
GAME_VERSION = "1.60.1"  # CurseForge's game-version tag for WoW Forever
DEFAULT_WOW_DIR = Path.home() / "Games/battlenet/drive_c/Program Files (x86)/World of Warcraft/_forever_"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "wu"
CONFIG_FILE = CONFIG_DIR / "config.json"
CF_API = "https://api.curse.tools/v1/cf"  # keyless proxy of the official CurseForge API
CF_SEARCH = f"{CF_API}/mods/search"


def configured_wow_dir():
    env = os.environ.get("WU_DIR") or os.environ.get("WOW_U_DIR")
    if env:
        return Path(env)
    try:
        return Path(json.loads(CONFIG_FILE.read_text())["wow_dir"])
    except (OSError, ValueError, KeyError):
        return DEFAULT_WOW_DIR


WOW_DIR = configured_wow_dir()
ADDONS_DIR = WOW_DIR / "Interface" / "AddOns"
